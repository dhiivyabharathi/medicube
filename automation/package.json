{
  "name": "medicube-automation",
  "version": "1.0.0",
  "description": "Medicube Playwright healthcare automation framework",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:auth": "playwright test tests/auth",
    "test:providers": "playwright test tests/providers",
    "test:patients": "playwright test tests/patients",
    "test:documents": "playwright test tests/documents",
    "test:medical-records": "playwright test tests/medical-records",
    "test:api": "playwright test tests/api",
    "publish-results": "tsx scripts/publish-results.ts",
    "test:and-publish": "playwright test && tsx scripts/publish-results.ts",
    "ci:summary": "node scripts/ci-summary.mjs",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "keywords": [
    "playwright",
    "qa",
    "healthcare"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.0"
  }
}
